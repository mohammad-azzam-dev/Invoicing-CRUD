@page "/invoices"
@using Microsoft.AspNetCore.Authorization
@using InvoiceApp.Domain
@using InvoiceApp.Features.Invoices.Dtos
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Invoices - Invoice Manager</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1" class="rz-m-0">Invoices</RadzenText>
    <RadzenButton Text="New Invoice" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@(() => Navigation.NavigateTo("/invoices/new"))" />
</RadzenStack>

<RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" class="rz-mb-4" Wrap="FlexWrap.Wrap">
    <RadzenTextBox Placeholder="Search by customer or invoice number..."
                   Style="width: 300px;"
                   @oninput="@(args => OnSearchChanged(args.Value?.ToString()))" />

    <RadzenDropDown TValue="InvoiceStatus?"
                    Data="@(Enum.GetValues<InvoiceStatus>().Cast<InvoiceStatus?>())"
                    Placeholder="All Statuses"
                    AllowClear="true"
                    Style="width: 180px;"
                    Value="@_selectedStatus"
                    ValueChanged="@OnStatusFilterChanged" />
</RadzenStack>

<RadzenDataGrid @ref="_grid"
                TItem="InvoiceListItemDto"
                Data="@_invoices"
                Count="@_count"
                LoadData="@LoadDataAsync"
                IsLoading="@_isLoading"
                AllowSorting="true"
                AllowPaging="true"
                PageSize="@Pagination.DefaultPageSize"
                PageSizeOptions="@PageSizeOptions"
                PagerHorizontalAlign="HorizontalAlign.Right"
                ShowPagingSummary="true"
                PagingSummaryFormat="Showing {0} to {1} of {2} invoices">
    <EmptyTemplate>
        <EmptyState Icon="receipt_long"
                    Message="No invoices found"
                    Hint="@(string.IsNullOrWhiteSpace(_searchText) && !_selectedStatus.HasValue ? "Create your first invoice to get started." : "Try adjusting your search or filter criteria.")" />
    </EmptyTemplate>
    <LoadingTemplate>
        <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" class="rz-p-8">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        </RadzenStack>
    </LoadingTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="InvoiceListItemDto" Title="" Width="50px" Sortable="false" TextAlign="TextAlign.Center">
            <Template Context="invoice">
                <ActionsMenu Items="@GetActionsForInvoice(invoice)"
                             Visible="@GetActionsForInvoice(invoice).Any()"
                             OnAction="@(action => OnActionSelected(invoice, action))" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="InvoiceListItemDto" Property="Number" Title="Number" Width="120px" />
        <RadzenDataGridColumn TItem="InvoiceListItemDto" Property="CustomerName" Title="Customer" />
        <RadzenDataGridColumn TItem="InvoiceListItemDto" Property="IssueDate" Title="Issue Date" Width="120px">
            <Template Context="invoice">
                @invoice.IssueDate.ToString("dd MMM yyyy")
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="InvoiceListItemDto" Property="DueDate" Title="Due Date" Width="120px">
            <Template Context="invoice">
                <DateBadge Date="@invoice.DueDate" IsOverdue="@invoice.IsOverdue" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="InvoiceListItemDto" Property="Status" Title="Status" Width="120px">
            <Template Context="invoice">
                <RadzenBadge Text="@invoice.Status.ToString()" Style="@GetStatusBadgeStyle(invoice.Status)" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="InvoiceListItemDto" Property="ItemCount" Title="Items" Width="80px" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn TItem="InvoiceListItemDto" Property="Total" Title="Total" Width="120px" TextAlign="TextAlign.End">
            <Template Context="invoice">
                @invoice.Total.ToString("C2")
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
