@using InvoiceApp.Features.Invoices.Dtos
@using InvoiceApp.Features.Invoices.Interfaces
@inject IInvoiceQueryService QueryService

<RadzenDropDown @bind-Value="Value"
                @bind-Value:after="OnValueChanged"
                Data="@_customers"
                TextProperty="DisplayName"
                ValueProperty="Id"
                Placeholder="Select a customer..."
                Disabled="@Disabled"
                Style="width: 100%;"
                AllowFiltering="true"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                Open="@OnDropdownOpen" />

@code {
    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnChange { get; set; }

    private IReadOnlyList<CustomerLookupDto> _customers = [];

    protected override async Task OnInitializedAsync()
    {
        _customers = await QueryService.GetCustomersForDropdownAsync();
    }

    private async Task OnDropdownOpen()
    {
        // Refresh customers each time dropdown opens to pick up newly added customers
        _customers = await QueryService.GetCustomersForDropdownAsync();
    }

    private async Task OnValueChanged()
    {
        await ValueChanged.InvokeAsync(Value);
        await OnChange.InvokeAsync();
    }
}
