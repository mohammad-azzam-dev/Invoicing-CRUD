@using InvoiceApp

<RadzenHeader Style="background: linear-gradient(135deg, #1a7f5a 0%, #1976d2 100%);">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0" class="rz-p-2">
        <AuthorizeView>
            <Authorized>
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0 rz-ml-2 text-white">Welcome to Invoice Manager, @context.User.Identity?.Name</RadzenText>
            </Authorized>
            <NotAuthorized>
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0 rz-ml-2 text-white">Invoice Manager</RadzenText>
            </NotAuthorized>
        </AuthorizeView>
        <div style="flex: 1"></div>
        <AuthorizeView>
            <Authorized>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                    <a href="@AppRoutes.Profile" class="rz-button rz-button-sm rz-variant-filled rz-light rz-shade-default" style="text-decoration: none;">
                        <RadzenIcon Icon="person" /> Profile
                    </a>
                    <form action="@AppRoutes.Account.Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@AppRoutes.Home" />
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Logout" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" />
                    </form>
                </RadzenStack>
            </Authorized>
            <NotAuthorized>
                <a href="@AppRoutes.Account.Login" class="rz-button rz-button-sm rz-variant-filled rz-light rz-shade-default" style="text-decoration: none;">
                    Login
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </RadzenStack>
</RadzenHeader>

